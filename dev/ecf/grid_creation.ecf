#!/bin/bash
#SBATCH -J nested_eagle_create_grids
#SBATCH -o slurm/grids_preprocessing.%j.out
#SBATCH -e slurm/grids_preprocessing.%j.err
#SBATCH --account=epic
#SBATCH --partition=u1-service
#SBATCH --mem=128g
#SBATCH -t 01:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1

set -x

## Set environment vars needed for prod type workflow
export KEEPDATA="NO"

export jobid=${SLURM_JOB_ID}
echo "jobid=${jobid}"

# shellcheck disable=SC1091
source /scratch4/NAGAPE/epic/role-epic/miniconda/bin/activate
conda activate eagle
module load gcc

export HOMEeagle=${PWD}/..

${HOMEeagle}/jobs/JGRID_CREATION

err=$?
if [[ ${err} -ne 0 ]]; then
#    ecflow_client --msg="*** JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT"
#    ecflow_client --abort
    echo "Aborted job with err=${err}"
    exit ${err}
else
    echo "Completed job"
    exit ${err}
fi
